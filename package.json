{
  "name": "encatch-electron-examples",
  "version": "0.1.0",
  "private": true,
  "description": "pnpm workspace hosting an AI-enabled chat application (Codex-style UI)",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @encatch/chat-app dev",
    "dev:bun": "pnpm --filter @encatch/bun-chat-app dev",
    "dev:tauri": "pnpm --filter @encatch/tauri-chat-app tauri:dev",
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @encatch/chat-app build",
    "build:bun": "pnpm -r --filter=./packages/* build && pnpm --filter @encatch/bun-chat-app build",
    "build:tauri": "pnpm -r --filter=./packages/* build && pnpm --filter @encatch/tauri-chat-app tauri:build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
